# ─────────────────────────────────────────────────────────────────────────────
# Portfolio environment variables
#
# Copy to `.env.local` for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for deployments.
# Every value here is public (NEXT_PUBLIC_*) — it ends up in the browser
# bundle, so never put secrets in this file.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical URL for SEO (canonical links, Open Graph, sitemap, robots.txt).
# No trailing slash. Defaults: Vercel production domain → the URL below.
NEXT_PUBLIC_SITE_URL=https://andresbetancourt-dev.vercel.app

# LinkedIn profile shown in the hero, menu, footer and contact section.
# Set to "none" to hide it.
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/andres-betancourth/

# Public contact email for the "Email me" buttons. Set to "none" to hide it.
NEXT_PUBLIC_CONTACT_EMAIL=contacto.betancourth@gmail.com

# Optional: open the bundle analyzer after `npm run build`.
# ANALYZE=true
